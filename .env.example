# A Slack app's signing secret. The observer never needs a bot token.
SLACK_SIGNING_SECRET=replace-me
# Static bearer token used only by MCP clients (agents).
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
# Static bearer token used only by people opening the dashboard.
DASHBOARD_AUTH_TOKEN=replace-with-a-long-random-secret
DATABASE_URL=postgres://observer:observer@db:5432/observer
PORT=3000
# Do not hand active conversations to an agent until this many seconds pass
# without a new message in the same thread.
THREAD_SETTLE_SECONDS=90
