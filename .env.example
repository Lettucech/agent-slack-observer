# Slack App-Level Token (xapp-...) with the connections:write scope. This is not a bot token.
SLACK_APP_TOKEN=replace-with-your-xapp-token
# Bot token (xoxb-...) used for cached metadata and only user-triggered, rate-limited history/thread backfill.
SLACK_BOT_TOKEN=replace-with-your-xoxb-token
# Static bearer token used only by MCP clients (agents).
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
# Host port for the dashboard and MCP endpoint. The container always listens on 3000.
PORT=3000
# Do not hand active conversations to an agent until this many seconds pass
# without a new message in the same thread.
THREAD_SETTLE_SECONDS=90
# Retain normalized messages/thread context for this long. Roots with a retained reply stay available for context.
MESSAGE_RETENTION_DAYS=30
# Raw Socket Mode and synthetic backfill event payloads have a shorter retention period.
RAW_EVENT_RETENTION_DAYS=7
# Conservative global minimum spacing for conversations.history and conversations.replies requests.
BACKFILL_REQUEST_INTERVAL_SECONDS=60
# Create a dashboard suggestion after a Socket Mode gap of at least this duration; no fetch starts automatically.
DOWNTIME_SUGGESTION_SECONDS=300
