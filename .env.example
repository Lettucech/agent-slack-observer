# Slack App-Level Token (xapp-...) with the connections:write scope. This is not a bot token.
SLACK_APP_TOKEN=replace-with-your-xapp-token
# Bot token (xoxb-...) used only to look up workspace and channel names, never message history.
SLACK_BOT_TOKEN=replace-with-your-xoxb-token
# Static bearer token used only by MCP clients (agents).
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
# Host port for the dashboard and MCP endpoint. The container always listens on 3000.
PORT=3000
# Do not hand active conversations to an agent until this many seconds pass
# without a new message in the same thread.
THREAD_SETTLE_SECONDS=90
